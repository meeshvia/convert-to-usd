{
  "manifest_version": 3,
  "name": "Convert to USD",
  "version": "1.0.1",
  "description": "Convert highlighted foreign-currency amounts to US dollars from the right-click menu.",
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["contextMenus"],
  "host_permissions": ["https://api.frankfurter.dev/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
